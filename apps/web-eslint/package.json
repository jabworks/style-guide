{
  "name": "web-eslint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "dev": "next dev --turbopack --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 && stylelint \"**/*.css\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "eslint --fix",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@jabworks/eslint-plugin": "workspace:*",
    "@jabworks/prettier-config": "workspace:*",
    "@jabworks/stylelint-config": "workspace:*",
    "@jabworks/typescript-config": "workspace:*",
    "@types/node": "^25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/browser-preview": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.5.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.62.0",
    "prettier": "^3.8.2",
    "stylelint": "^17.13.0",
    "typescript": "6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
