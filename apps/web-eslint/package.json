{
  "name": "web-eslint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "dev": "next dev --turbopack --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 && stylelint \"**/*.css\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "eslint --fix",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@jabworks/eslint-plugin": "workspace:*",
    "@jabworks/prettier-config": "workspace:*",
    "@jabworks/stylelint-config": "workspace:*",
    "@jabworks/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/browser-preview": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
