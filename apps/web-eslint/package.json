{
  "name": "web-eslint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "dev": "next dev --turbopack --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 && stylelint \"**/*.css\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "eslint --fix",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@jabworks/eslint-plugin": "workspace:*",
    "@jabworks/prettier-config": "workspace:*",
    "@jabworks/stylelint-config": "workspace:*",
    "@jabworks/typescript-config": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/browser-preview": "^5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
