{
  "name": "@jabworks/oxlint-config",
  "version": "0.6.0",
  "private": false,
  "description": "Opinionated oxlint presets for JS, TS, React, React Native, Next.js, and Vitest, ported from @jabworks/eslint-plugin",
  "keywords": [
    "linter",
    "oxc",
    "oxlint",
    "oxlint-config",
    "typescript"
  ],
  "homepage": "https://github.com/jabworks/style-guide/tree/main/packages/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/jabworks/style-guide/issues"
  },
  "license": "MIT",
  "author": "Vi Minh Hiếu <jabworks@hieuvi.dev> (https://hieuvi.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabworks/style-guide.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@jabworks/typescript-config": "workspace:*",
    "oxlint": "^1.85.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint-plugin-expo": ">=1.1.0",
    "oxlint": ">=1.85.0",
    "oxlint-plugin-react-native": ">=0.2.35"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-expo": {
      "optional": true
    },
    "oxlint-plugin-react-native": {
      "optional": true
    }
  }
}
