{
  "name": "@jabworks/eslint-plugin",
  "version": "3.0.0",
  "private": false,
  "description": "Opinionated ESLint plugin and flat config for JS, TS, React, and Next.js",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-plugin",
    "eslintplugin",
    "typescript",
    "typescript-eslint"
  ],
  "homepage": "https://github.com/jabworks/style-guide/tree/main/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/jabworks/style-guide/issues"
  },
  "license": "MIT",
  "author": "Vi Minh Hiếu <jabworks@hieuvi.dev> (https://hieuvi.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabworks/style-guide.git",
    "directory": "packages/eslint-plugin"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "@jabworks/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.8.1",
    "typescript-eslint": "^8.54.0"
  }
}
