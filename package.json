{
  "name": "@jabworks/style-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:deps": "node scripts/audit.js",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter \"./packages/**\"",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "oxfmt && turbo run format",
    "format:check": "oxfmt --check && turbo run format:check",
    "lint": "turbo run lint",
    "lint:packages": "oxlint packages",
    "release": "changeset publish",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@jabworks/oxfmt-config": "workspace:*",
    "@jabworks/oxlint-config": "workspace:*",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "semver": "^7.8.5",
    "turbo": "^2.9.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
